# Copy to .env (make setup does this). Every variable is optional.
# Root for raw/interim/processed data (point at an external drive if space is tight).
# TH_DATA_DIR=./data
# TH_MODELS_DIR=./models
# TH_CACHE_DIR=./data/cache

# Where lightkurve stores downloaded FITS files. Unset = ~/.lightkurve/cache
# TH_LIGHTKURVE_CACHE_DIR=./data/raw

TH_API_HOST=0.0.0.0
TH_API_PORT=8000
TH_API_URL=http://localhost:8000
TH_MAST_TIMEOUT_S=120

# true = never contact MAST; only pre-cached demo targets work. Use this on stage if Wi-Fi is bad.
TH_OFFLINE=false

# cnn | gbm | auto (auto = whichever scored best on the validation split)
TH_MODEL_KIND=auto
TH_LOG_LEVEL=INFO
